<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCleaner · Mises à jour des applications" Height="640" Width="920"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource BgMain}" Padding="28,26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Mises à jour des applications" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Utilise Windows Package Manager (winget). Les applications dont la version est inconnue sont ignorées. La mise à jour demande une autorisation administrateur."
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextPrimary}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             AutomationProperties.Name="Sortie winget"/>
                    <StackPanel x:Name="OutputPlaceholder" HorizontalAlignment="Center"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="La sortie de winget apparaîtra ici." FontSize="13"
                                   Foreground="{DynamicResource TextSecond}" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="12"
                               Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="CheckBtn" Content="Vérifier les mises à jour"
                                Style="{StaticResource SecondBtnStyle}" Click="Check_Click" Margin="0,0,8,0"/>
                        <Button x:Name="UpgradeBtn" Content="Tout mettre à jour"
                                Style="{StaticResource AccentBtnStyle}" Click="Upgrade_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CancelBtn" Content="Annuler"
                                Style="{StaticResource SecondBtnStyle}" Click="Cancel_Click" IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
