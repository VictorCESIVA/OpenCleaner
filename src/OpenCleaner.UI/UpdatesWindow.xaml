<UserControl x:Class="OpenCleaner.UI.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization"
        PreviewKeyDown="Updates_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="UpdatesDetailsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderButton"
                                              Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="True">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderSurface" Background="Transparent" Padding="16,11" CornerRadius="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0"
                                                          Stroke="{DynamicResource TextSecond}" StrokeThickness="1.3"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.FontSize="12"
                                                                      TextElement.FontWeight="SemiBold"
                                                                      TextElement.Foreground="{DynamicResource TextPrimary}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource BgHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="16,0,16,14"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgMain}" Padding="28,26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{loc:Translate Updates.Title}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{loc:Translate Updates.Subtitle}"
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border x:Name="AlertBanner" Grid.Row="1" Background="{DynamicResource WarnSoft}"
                    BorderBrush="{DynamicResource WarnColor}" BorderThickness="1" CornerRadius="10"
                    Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource WarnColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AlertText" FontSize="12" Foreground="{DynamicResource WarnColor}"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.Name="{loc:Translate Updates.AlertAutomation}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                <WrapPanel>
                    <Button x:Name="CheckBtn" Content="{loc:Translate Updates.Check}"
                            Style="{StaticResource SecondBtnStyle}" Click="Check_Click" Margin="0,0,8,0"
                            AutomationProperties.Name="{loc:Translate Updates.Check}"/>
                    <Button x:Name="SelectAllBtn" Content="{loc:Translate Updates.SelectAll}"
                            Style="{StaticResource SecondBtnStyle}" Click="SelectAll_Click" Margin="0,0,8,0"
                            AutomationProperties.Name="{loc:Translate Updates.SelectAll}"/>
                    <Button x:Name="SelectNoneBtn" Content="{loc:Translate Updates.SelectNone}"
                            Style="{StaticResource SecondBtnStyle}" Click="SelectNone_Click" Margin="0,0,16,0"
                            AutomationProperties.Name="{loc:Translate Updates.SelectNone}"/>
                    <Button x:Name="UpdateSelectedBtn" Content="{loc:Translate Updates.UpdateSelected}"
                            Style="{StaticResource AccentBtnStyle}" Click="UpdateSelected_Click" Margin="0,0,8,0"
                            AutomationProperties.Name="{loc:Translate Updates.UpdateSelected}"/>
                    <Button x:Name="UpdateAllBtn" Content="{loc:Translate Updates.UpgradeAll}"
                            Style="{StaticResource SecondBtnStyle}" Click="UpdateAll_Click" Margin="0,0,8,0"
                            AutomationProperties.Name="{loc:Translate Updates.UpgradeAll}"/>
                    <Button x:Name="CancelBtn" Content="{loc:Translate Updates.Cancel}"
                            Style="{StaticResource SecondBtnStyle}" Click="Cancel_Click"
                            Visibility="Collapsed"
                            AutomationProperties.Name="{loc:Translate Updates.Cancel}"/>
                </WrapPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
                <Grid ClipToBounds="True">
                    <ListBox x:Name="UpdatesList" Style="{StaticResource ToolListBoxStyle}"
                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                             ClipToBounds="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             SelectionMode="Single"
                             AutomationProperties.Name="{loc:Translate Updates.ListAutomation}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ToolListItemStyle}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="72" Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsSelectable}"
                                              AutomationProperties.Name="{Binding SelectionAutomationName}"/>

                                    <StackPanel Grid.Column="1" Margin="10,8,16,8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding NameToolTip}"/>
                                        <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                   ToolTip="{Binding Id}"/>
                                        <TextBlock Text="{Binding ErrorText}" FontSize="10.5"
                                                   Foreground="{DynamicResource RiskExpert}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                   ToolTip="{Binding ErrorText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,14,0">
                                        <Border CornerRadius="6" Background="{DynamicResource BgMain}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="7,3">
                                            <TextBlock Text="{Binding CurrentVersionLabel}" FontFamily="Consolas"
                                                       FontSize="10.5" Foreground="{DynamicResource TextSecond}"/>
                                        </Border>
                                        <TextBlock Text="&#x2192;" FontSize="11" Foreground="{DynamicResource TextSecond}"
                                                   VerticalAlignment="Center" Margin="7,0"/>
                                        <Border CornerRadius="6" Background="{DynamicResource AccentSoft}"
                                                BorderBrush="{DynamicResource HeroBorder}" BorderThickness="1" Padding="7,3">
                                            <TextBlock Text="{Binding AvailableVersionLabel}" FontFamily="Consolas"
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="3" CornerRadius="99" Padding="8,3"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStoreSource}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource VioletSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>
                                    </Border>

                                    <StackPanel Grid.Column="4" MinWidth="124" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{Binding StatusBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" TextWrapping="Wrap"
                                                       AutomationProperties.Name="{Binding StatusText}"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="StateIcon" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock x:Name="StateTitle" Text="{loc:Translate Updates.State.InitialTitle}"
                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock x:Name="StateDescription" Text="{loc:Translate Updates.State.InitialDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextSecond}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                   MaxWidth="420"/>
                        <ProgressBar x:Name="StateProgress" IsIndeterminate="True" Width="180" Height="4"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource BgMain}"
                                     Margin="0,14,0,0" Visibility="Collapsed"
                                     AutomationProperties.Name="{loc:Translate Common.ProgressAutomation}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Expander x:Name="DetailsExpander" Grid.Row="4" Margin="0,12,0,0"
                      Style="{StaticResource UpdatesDetailsExpander}" IsExpanded="False"
                      Header="{loc:Translate Updates.Details}"
                      AutomationProperties.Name="{loc:Translate Updates.DetailsAutomation}">
                <Grid>
                    <TextBox x:Name="DetailsLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             Height="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource Border}" BorderThickness="1"
                             FontFamily="Consolas" FontSize="11" Padding="10,8"
                             AutomationProperties.Name="{loc:Translate Updates.LogAutomation}"/>
                    <TextBlock x:Name="DetailsPlaceholder" Text="{loc:Translate Updates.DetailsEmpty}"
                               FontSize="11" Foreground="{DynamicResource TextSecond}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Expander>

            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="OverallProgress" Grid.Column="0" Height="4"
                                     Minimum="0" Maximum="1" Value="0"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}"
                                     BorderThickness="0" VerticalAlignment="Center" Visibility="Collapsed"
                                     AutomationProperties.Name="{loc:Translate Updates.ProgressAutomation}"/>
                        <TextBlock x:Name="ProgressText" Grid.Column="1" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock x:Name="SelectedCountText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Text="—"/>
                            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextSecond}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Text="—"
                                       AutomationProperties.Name="{loc:Translate Updates.StatusAutomation}"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
