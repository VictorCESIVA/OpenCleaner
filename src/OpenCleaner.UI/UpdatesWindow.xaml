<UserControl x:Class="OpenCleaner.UI.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization">
    <Border Background="{DynamicResource BgMain}" Padding="28,26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{loc:Translate Updates.Title}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{loc:Translate Updates.Subtitle}"
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextPrimary}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             AutomationProperties.Name="{loc:Translate Updates.OutputAutomation}"/>
                    <StackPanel x:Name="OutputPlaceholder" HorizontalAlignment="Center"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="{loc:Translate Updates.EmptyOutput}" FontSize="13"
                                   Foreground="{DynamicResource TextSecond}" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="12"
                               Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="CheckBtn" Content="{loc:Translate Updates.Check}"
                                Style="{StaticResource SecondBtnStyle}" Click="Check_Click" Margin="0,0,8,0"/>
                        <Button x:Name="UpgradeBtn" Content="{loc:Translate Updates.UpgradeAll}"
                                Style="{StaticResource AccentBtnStyle}" Click="Upgrade_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CancelBtn" Content="{loc:Translate Updates.Cancel}"
                                Style="{StaticResource SecondBtnStyle}" Click="Cancel_Click" IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
