<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCleaner · Démarrage Windows" Height="700" Width="1080"
        MinHeight="540" MinWidth="840"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource BgMain}" Padding="28,26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Démarrage Windows" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Programmes lancés à l'ouverture de session. Les éléments utilisateur sont déplacés vers une sauvegarde OpenCleaner ; les éléments machine nécessitent les droits administrateur."
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <TextBox x:Name="FilterBox" Height="34"
                         Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10,6"
                         TextChanged="Filter_Changed" AutomationProperties.Name="Filtrer le démarrage"/>
                <TextBlock Text="Rechercher un élément de démarrage…" Margin="12,0,0,0"
                           FontSize="12" Foreground="{DynamicResource TextSecond}"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <Grid>
                <ListView x:Name="StartupList" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextPrimary}" FontSize="12"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Single" SelectionChanged="StartupList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nom" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Commande" Width="390">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextSecond}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Emplacement" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding LocationLabel}" Foreground="{DynamicResource TextSecond}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Statut" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="24,44,24,0" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=StartupList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="Aucun élément de démarrage détecté." FontSize="15"
                               FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Les programmes lancés à l'ouverture de session apparaîtront ici."
                               FontSize="12" Foreground="{DynamicResource TextSecond}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Text="—"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextSecond}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="RefreshBtn" Content="Actualiser"
                                Style="{StaticResource SecondBtnStyle}" Click="Refresh_Click" Margin="0,0,8,0"/>
                        <Button x:Name="DisableBtn" Content="Désactiver"
                                Style="{StaticResource DangerBtnStyle}" Click="Disable_Click" IsEnabled="False" Margin="0,0,8,0"/>
                        <Button x:Name="EnableBtn" Content="Réactiver"
                                Style="{StaticResource AccentBtnStyle}" Click="Enable_Click" IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
