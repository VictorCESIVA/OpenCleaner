<UserControl x:Class="OpenCleaner.UI.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization"
        PreviewKeyDown="Startup_PreviewKeyDown">
    <Border Background="{DynamicResource BgMain}" Padding="28,26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{loc:Translate Startup.Title}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{loc:Translate Startup.Subtitle}"
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" Grid.Column="0" Height="38"
                         Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="36,7,12,7"
                         VerticalContentAlignment="Center"
                         TextChanged="Filter_Changed" AutomationProperties.Name="{loc:Translate Startup.FilterAutomation}"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource TextSecond}" Margin="12,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="{loc:Translate Startup.SearchPlaceholder}" Margin="38,0,0,0"
                           FontSize="12" Foreground="{DynamicResource TextSecond}"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox x:Name="SortCombo" Grid.Column="1" Width="170" Height="38" Margin="8,0,0,0"
                          SelectedIndex="0" SelectionChanged="Sort_Changed"
                          AutomationProperties.Name="{loc:Translate Startup.SortAutomation}">
                    <ComboBoxItem Content="{loc:Translate Startup.SortName}" Tag="Name"/>
                    <ComboBoxItem Content="{loc:Translate Startup.SortImpact}" Tag="Impact"/>
                </ComboBox>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
                <Grid ClipToBounds="True">
                    <ListBox x:Name="StartupList" Style="{StaticResource ToolListBoxStyle}"
                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                             ClipToBounds="True"
                             ItemContainerStyle="{StaticResource ToolListItemStyle}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionMode="Single" SelectionChanged="StartupList_SelectionChanged"
                             AutomationProperties.Name="{loc:Translate Startup.ListAutomation}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="70" Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource AppIconTileStyle}"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding Icon}" Width="28" Height="28"
                                                   Stretch="Uniform" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                   ToolTip="{Binding Command}"/>
                                        <TextBlock Text="{Binding ImpactLabel}" FontSize="10.5"
                                                   Foreground="{Binding ImpactBrush}"
                                                   ToolTip="{Binding ImpactToolTip}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" MinWidth="120" MaxWidth="180"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border CornerRadius="99" Padding="8,3" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                                       TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarnColor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding LocationLabel}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   HorizontalAlignment="Right" TextAlignment="Right"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Startup.Loading}" FontSize="15" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource BgMain}"
                                     Margin="0,14,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock x:Name="EmptyTitle" Text="{loc:Translate Startup.EmptyTitle}" FontSize="15"
                                   FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyDescription" Text="{loc:Translate Startup.EmptyDescription}"
                                   FontSize="12" Foreground="{DynamicResource TextSecond}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                   MaxWidth="360"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Text="—"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextSecond}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="RefreshBtn" Content="{loc:Translate Startup.Refresh}"
                                Style="{StaticResource SecondBtnStyle}" Click="Refresh_Click" Margin="0,0,8,0"/>
                        <Button x:Name="DisableBtn" Content="{loc:Translate Startup.Disable}"
                                Style="{StaticResource DangerBtnStyle}" Click="Disable_Click" IsEnabled="False" Margin="0,0,8,0"/>
                        <Button x:Name="EnableBtn" Content="{loc:Translate Startup.Enable}"
                                Style="{StaticResource AccentBtnStyle}" Click="Enable_Click" IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
