<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.DiskSpaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyseur d'espace disque" Height="760" Width="1120" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Espace disque"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" Text="Parcourez les dossiers et identifiez ce qui occupe le plus de place sur votre disque."
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- STATS -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Padding="20,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="StatTotal" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="Volume analysé" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatHuge" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource SizeHuge}"/>
                        <TextBlock Text="≥ 1 Go" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="StatLarge" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource SizeLarge}"/>
                        <TextBlock Text="≥ 100 Mo" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock x:Name="StatFiles" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Entrées analysées" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BARRE DE CONTRÔLE -->
            <Border Grid.Row="2" Style="{StaticResource Card}"
                    Padding="16,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Lecteur :"
                               Foreground="{DynamicResource TextSecond}"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <ComboBox x:Name="DriveCombo" Grid.Column="1"
                              Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextPrimary}"
                              BorderBrush="{DynamicResource Border}"
                              SelectionChanged="DriveCombo_Changed"
                              Height="32"/>
                    <TextBlock Grid.Column="2" x:Name="PathBreadcrumb"
                               Text="" FontSize="11"
                               Foreground="{DynamicResource TextSecond}"
                               VerticalAlignment="Center" Margin="12,0"/>
                    <Button Grid.Column="3" Content="← Remonter"
                            Style="{StaticResource SecondBtn}"
                            Click="GoUp_Click" Margin="0,0,8,0"
                            x:Name="GoUpBtn" IsEnabled="False"/>
                    <Button Grid.Column="4" Content="Fichiers &gt; 500 Mo"
                            Style="{StaticResource SecondBtn}"
                            Click="FilterLarge_Click" Margin="0,0,8,0"/>
                    <Button Grid.Column="5" Content="Analyser"
                            Style="{StaticResource AccentBtn}"
                            Click="Scan_Click" x:Name="ScanBtn"/>
                </Grid>
            </Border>

            <!-- LISTVIEW PRINCIPALE -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,0,8,8">
                <Grid><ListView x:Name="ResultList"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource TextPrimary}"
                          FontSize="12"
                          MouseDoubleClick="ResultList_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Taille" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeLabel}"
                                                   Foreground="{Binding SizeColor}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Répartition" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding BarPercent}"
                                                     Foreground="{Binding SizeColor}"
                                                     Background="{DynamicResource Border}"
                                                     BorderThickness="0"
                                                     Height="8" Width="150"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeIcon}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Chemin" Width="600">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,44,24,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ResultList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/><TextBlock Text="Découvrez ce qui prend de la place." FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Choisissez un lecteur, puis lancez une analyse." FontSize="12" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid>
            </Border>

            <!-- STATUS BAR -->
            <Border Grid.Row="4" Style="{StaticResource Card}"
                    Padding="16,10" Margin="0,10,0,0">
                <TextBlock TextWrapping="Wrap" Margin="0,0,16,0" x:Name="StatusText"
                           Text="Sélectionnez un lecteur et cliquez Analyser."
                           Foreground="{DynamicResource TextSecond}" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</Window>
