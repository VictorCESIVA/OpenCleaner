<UserControl x:Class="OpenCleaner.UI.DiskSpaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenCleaner.UI">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Espace disque"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" Text="Visualisez ce qui occupe la place : carte proportionnelle, dossiers et plus gros fichiers."
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- STATS -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Padding="20,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="StatTotal" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="Volume accessible" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatFiles" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Fichiers" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="StatDirs" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Dossiers" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock x:Name="StatLargest" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource SizeLarge}"/>
                        <TextBlock Text="Plus gros fichier" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BARRE DE CONTRÔLE -->
            <Border Grid.Row="2" Style="{StaticResource Card}"
                    Padding="16,10" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lecteur :"
                                   Foreground="{DynamicResource TextSecond}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                        <ComboBox x:Name="DriveCombo" Grid.Column="1"
                                  SelectionChanged="DriveCombo_Changed"
                                  Height="32"/>
                        <TextBlock Grid.Column="2" x:Name="PathBreadcrumb"
                                   Text="" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecond}"
                                   VerticalAlignment="Center" Margin="12,0"/>
                        <Button Grid.Column="3" Content="← Remonter"
                                Style="{StaticResource SecondBtnStyle}"
                                Click="GoUp_Click" Margin="0,0,8,0"
                                x:Name="GoUpBtn" IsEnabled="False"/>
                        <Button Grid.Column="4" Content="Explorer"
                                ToolTip="Ouvrir l'élément sélectionné dans l'Explorateur Windows"
                                Style="{StaticResource SecondBtnStyle}"
                                Click="Reveal_Click" Margin="0,0,8,0"
                                x:Name="RevealBtn"/>
                        <Button Grid.Column="5" Content="Analyser"
                                Style="{StaticResource AccentBtnStyle}"
                                Click="Scan_Click" x:Name="ScanBtn"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ViewMapBtn" Grid.Column="0" Content="Carte"
                                Style="{StaticResource AccentBtnStyle}" Padding="14,6" MinHeight="32"
                                Margin="0,0,6,0" Click="ViewMap_Click"/>
                        <Button x:Name="ViewListBtn" Grid.Column="1" Content="Liste"
                                Style="{StaticResource SecondBtnStyle}" Padding="14,6" MinHeight="32"
                                Margin="0,0,6,0" Click="ViewList_Click"/>
                        <Button x:Name="ViewFilesBtn" Grid.Column="2" Content="Plus gros fichiers"
                                Style="{StaticResource SecondBtnStyle}" Padding="14,6" MinHeight="32"
                                Margin="0,0,6,0" Click="ViewFiles_Click"/>
                        <Button x:Name="ViewAppsBtn" Grid.Column="3" Content="Applications"
                                Style="{StaticResource SecondBtnStyle}" Padding="14,6" MinHeight="32"
                                Click="ViewApps_Click"/>
                        <TextBlock x:Name="MapHint" Grid.Column="4" Margin="14,0,0,0"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Double-cliquez sur un dossier pour l'explorer."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CONTENU PRINCIPAL -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,0,8,8">
                <Grid>
                    <ListView x:Name="ResultList"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="12"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              MouseDoubleClick="ResultList_DoubleClick"
                              AutomationProperties.Name="Contenu du dossier">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Taille" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeLabel}"
                                                       Foreground="{Binding SizeColor}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Répartition" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding BarPercent, Mode=OneWay}"
                                                         Foreground="{Binding SizeColor}"
                                                         Background="{DynamicResource Border}"
                                                         BorderThickness="0"
                                                         Height="8" Width="100"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TypeIcon}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Nom" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Détail" Width="240">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{DynamicResource TextSecond}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid x:Name="MapHost" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:TreemapControl x:Name="Treemap" Margin="2" MinHeight="180"
                                              AutomationProperties.Name="Carte proportionnelle de l'espace disque"/>
                        <TextBlock Grid.Row="1" Margin="10,6,10,4" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecond}"
                                   Text="Chaque surface est proportionnelle à la taille. Ambre : zone protégée, non supprimable. Double-clic : explorer le dossier."/>
                    </Grid>

                    <ListView x:Name="LargestList"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="12"
                              Visibility="Collapsed"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              MouseDoubleClick="LargestList_DoubleClick"
                              AutomationProperties.Name="Plus gros fichiers">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Taille" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeLabel}"
                                                       Foreground="{Binding SizeColor}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Modifié" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ModifiedLabel}"
                                                       Foreground="{DynamicResource TextSecond}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Fichier" Width="640">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}"
                                                       Foreground="{DynamicResource TextSecond}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ListView x:Name="ApplicationsList"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="12"
                              Visibility="Collapsed"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              MouseDoubleClick="ApplicationsList_DoubleClick"
                              AutomationProperties.Name="Applications et espace occupé">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Taille" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeLabel}"
                                                       Foreground="{Binding SizeColor}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Application" Width="230">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Éditeur" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Publisher}"
                                                       Foreground="{DynamicResource TextSecond}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Emplacement" Width="390">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Location}" ToolTip="{Binding Location}"
                                                       Foreground="{DynamicResource TextSecond}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Source" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       Foreground="{Binding SourceBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="24,44,24,0" IsHitTestVisible="False">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="Découvrez ce qui prend de la place." FontSize="15"
                                   FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="Choisissez un lecteur, puis lancez une analyse. Rien n'est supprimé."
                                   FontSize="12" Foreground="{DynamicResource TextSecond}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATUS BAR -->
            <Border Grid.Row="4" Style="{StaticResource Card}"
                    Padding="16,10" Margin="0,10,0,0">
                <TextBlock TextWrapping="Wrap" Margin="0,0,16,0" x:Name="StatusText"
                           Text="Sélectionnez un lecteur et cliquez Analyser."
                           Foreground="{DynamicResource TextSecond}" FontSize="12"
                           AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
