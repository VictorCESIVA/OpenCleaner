<UserControl x:Class="OpenCleaner.UI.DevCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{loc:Translate Dev.Title}"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" Text="{loc:Translate Dev.Subtitle}"
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- SÉLECTION CATÉGORIES + WARNING DOCKER -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}"
                        Padding="20,14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Dev.CategoriesTitle}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <CheckBox x:Name="CbNode" Content="node_modules" IsChecked="False" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{loc:Translate Dev.NodeTip}" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbNpm"     Content="{loc:Translate Dev.CacheNpm}"              IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbYarn"    Content="{loc:Translate Dev.CacheYarn}"             IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbNuGet"   Content="{loc:Translate Dev.CacheNuGet}"            IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbPip"     Content="{loc:Translate Dev.CachePip}"              IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbGradle"  Content="{loc:Translate Dev.CacheGradle}"           IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbVsCode"  Content="VS Code"                IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbDiscord" Content="Discord"                IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbSpotify" Content="Spotify"                IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbTeams"   Content="Microsoft Teams"        IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbJetBrains" Content="JetBrains"            IsChecked="True" Margin="0,5,24,5"/>
                            <CheckBox x:Name="CbAi" Content="{loc:Translate Dev.Ai}"             IsChecked="True" Margin="0,5,24,5" ToolTip="{loc:Translate Dev.AiTip}"/>
                            <CheckBox x:Name="CbDocker" Content="Docker" IsChecked="False" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{loc:Translate Dev.DockerTip}" Margin="0,5,24,5"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- WARNING Docker + Stats -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Dev.SafeTitle}"
                                       FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecond}"
                                       Text="{loc:Translate Dev.SafeDescription}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Dev.Volume}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecond}"/>
                            <TextBlock x:Name="EstimateText" Text="—"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}"
                                       Margin="0,6,0,0"/>
                            <TextBlock x:Name="EstimateDetail" Text=""
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecond}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- LISTE RÉSULTATS -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,0,8,8">
                <Grid><ListView x:Name="ResultList"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource TextPrimary}"
                          FontSize="12"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="ResultList_DoubleClick"
                          SelectionMode="Multiple">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="☑" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Background="Transparent"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Translate Dev.ColCategory}" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="{DynamicResource Accent}"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Translate Dev.ColSize}" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeLabel}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Translate Dev.ColDescription}" Width="580">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PathLabel}" ToolTip="{Binding PathLabel}"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,44,24,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ResultList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/><TextBlock Text="{loc:Translate Dev.EmptyTitle}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{loc:Translate Dev.EmptyDescription}" FontSize="12" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid>
            </Border>

            <!-- ACTIONS -->
            <Border Grid.Row="3" Style="{StaticResource Card}"
                    Padding="16,12" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,16,0"
                               Text="{loc:Translate Dev.Hint}"
                               Foreground="{DynamicResource TextSecond}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="1" Content="{loc:Translate Dev.SelectAll}"
                            Click="SelectAll_Click"
                            Background="Transparent" Foreground="{DynamicResource TextSecond}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            Padding="12,8" Cursor="Hand" Margin="0,0,8,0"
                            x:Name="SelectAllBtn" IsEnabled="False"/>
                    <Button Grid.Column="2" Content="{loc:Translate Dev.Analyze}"
                            Style="{StaticResource AccentBtn}"
                            Click="Scan_Click" x:Name="ScanBtn"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="3" Content="{loc:Translate Dev.CleanSelection}"
                            Style="{StaticResource AccentBtn}"
                            Click="Clean_Click"
                            x:Name="CleanBtn" IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
