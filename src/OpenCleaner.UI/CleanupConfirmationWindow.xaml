<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.CleanupConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization"
        Title="{loc:Translate Cleanup.Title}" Width="740" Height="430" MinWidth="700" MinHeight="410"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="{DynamicResource BgMain}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Translate Cleanup.Title}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="ContextText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecond}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <Border Style="{StaticResource Card}" Padding="16,13">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Cleanup.WithBackup}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Translate Cleanup.WithBackupDetail}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecond}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnColor}" Padding="16,13" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Cleanup.WithoutBackup}" FontWeight="SemiBold" Foreground="{DynamicResource WarnColor}"/>
                    <TextBlock Text="{loc:Translate Cleanup.WithoutBackupDetail}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="{loc:Translate Main.Cancel}" IsCancel="True" IsDefault="True" Margin="0,0,10,0"/>
            <Button x:Name="DeleteWithoutBackupButton" Content="{loc:Translate Cleanup.DeleteWithoutBackup}" Click="DeleteWithoutBackup_Click" Style="{StaticResource DangerBtnStyle}" Margin="0,0,10,0"/>
            <Button x:Name="BackupAndDeleteButton" Content="{loc:Translate Cleanup.BackupAndDelete}" Click="BackupAndDelete_Click" Style="{StaticResource AccentBtnStyle}"/>
        </WrapPanel>
    </Grid>
    </Border>
</Window>
