<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCleaner · Santé du PC" Height="680" Width="900"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource BgMain}" Padding="28,26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Santé du PC" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Informations système, corbeille et cache DNS."
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="HealthText" Text="" Visibility="Collapsed"
                                   FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap" LineHeight="22"/>
                    </ScrollViewer>
                    <StackPanel x:Name="HealthPlaceholder" HorizontalAlignment="Center"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Lecture des informations système…" FontSize="15"
                                   FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="Processeur, mémoire, disques et corbeille."
                                   FontSize="12" Foreground="{DynamicResource TextSecond}"
                                   TextAlignment="Center" Margin="0,6,0,14"/>
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource BgMain}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock x:Name="RecycleText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Text="Corbeille : —"/>
                        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextSecond}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="RefreshBtn" Content="Actualiser"
                                Style="{StaticResource SecondBtnStyle}" Click="Refresh_Click" Margin="0,0,8,0"/>
                        <Button x:Name="FlushDnsBtn" Content="Vider le cache DNS"
                                Style="{StaticResource SecondBtnStyle}" Click="FlushDns_Click" Margin="0,0,8,0"/>
                        <Button x:Name="EmptyRecycleBtn" Content="Vider la corbeille"
                                Style="{StaticResource DangerBtnStyle}" Click="EmptyRecycle_Click"
                                IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
