<UserControl x:Class="OpenCleaner.UI.HealthWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,28">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Santé du PC" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="Surveillez les ressources et accédez aux outils utiles." Foreground="{DynamicResource TextSecond}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="RefreshBtn" Grid.Column="1" Content="Actualiser" Click="Refresh_Click" VerticalAlignment="Center"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ESPACE DE STOCKAGE" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Espace disponible sur vos disques" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,12"/>
                    <StackPanel x:Name="DisksPanel"/>
                    <TextBlock Text="L'espace libre ne mesure pas l'état physique du disque." FontSize="11" Foreground="{DynamicResource TextSecond}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <Button Content="Explorer l'espace disque" Style="{StaticResource SecondBtnStyle}" Click="Disk_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="MÉMOIRE" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="MemoryText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,4"/>
                        <TextBlock x:Name="MemoryDetail" Text="Lecture en cours…" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="MemoryBar" Style="{StaticResource ModernProgressBar}" Height="6" Minimum="0" Maximum="100" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="WINDOWS EN COURS DEPUIS" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="UptimeText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,4"/>
                        <TextBlock x:Name="SystemText" Text="Lecture en cours…" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ACTIONS UTILES" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Prenez la main" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <TextBlock x:Name="AdviceText" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="RecycleText" Text="Corbeille : lecture en cours…" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Nettoyer les fichiers" Click="Clean_Click" Style="{StaticResource AccentBtnStyle}" Margin="0,0,8,8"/>
                        <Button Content="Gérer le démarrage" Click="Startup_Click" Margin="0,0,8,8"/>
                        <Button Content="Mises à jour" Click="Updates_Click" Margin="0,0,8,8"/>
                        <Button x:Name="EmptyRecycleBtn" Content="Vider la corbeille" Click="EmptyRecycle_Click" Style="{StaticResource DangerBtnStyle}" IsEnabled="False" Margin="0,0,8,8"/>
                        <Button x:Name="FlushDnsBtn" Content="Vider le cache DNS" Click="FlushDns_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecond}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="HealthText" Foreground="{DynamicResource TextSecond}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
