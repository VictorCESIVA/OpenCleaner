<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenCleaner.UI"
        Title="Restauration des fichiers" Height="640" Width="1000" MinHeight="540" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        x:Name="RestoreRoot">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Restauration"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" Text="Retrouvez vos fichiers sauvegardés et restaurez-les à leur emplacement d'origine."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecond}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- SÉPARATEUR + FILTRE -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Les sauvegardes occupent de l'espace jusqu'à leur suppression. Supprimer une sauvegarde retire la possibilité de restaurer ce fichier." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" x:Name="BackupSummaryText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0" Padding="10,6" FontSize="12"
                                 ToolTip="Filtrer les sauvegardes par nom ou chemin d'origine"
                                 AutomationProperties.Name="Filtrer les sauvegardes"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Button x:Name="OpenFolderBtn" Grid.Column="1" Content="Ouvrir le dossier d'origine"
                                Style="{StaticResource SecondBtnStyle}" Padding="12,6" MinHeight="32" Margin="10,0,0,0"
                                IsEnabled="False" Click="OpenFolder_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- LISTE DES BACKUPS -->
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"

                    Padding="4">
                <Grid><ListView x:Name="BackupsListView"
                          Background="Transparent"
                          BorderThickness="0"
                          ItemContainerStyle="{StaticResource RestoreItemStyle}"
                          SelectionChanged="BackupsListView_SelectionChanged"
                          SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>

                            <!-- ICÔNE -->
                            <GridViewColumn Header=" " Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextSecond}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- DATE FORMAT "il y a X jours" -->
                            <GridViewColumn Header="Date" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CreatedAt, Converter={x:Static local:LocalDateConverter.Instance}}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding CreatedAt, Converter={x:Static local:RelativeDateConverter.Instance}}"
                                                       Foreground="{DynamicResource TextSecond}"
                                                       FontSize="10"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- CHEMIN ORIGINAL -->
                            <GridViewColumn Header="Fichier original" Width="360">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OriginalPath}" ToolTip="{Binding OriginalPath}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- TAILLE -->
                            <GridViewColumn Header="Taille" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Size, Converter={x:Static local:BytesConverter.Instance}}"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,44,24,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=BackupsListView}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/><TextBlock Text="Aucune sauvegarde pour le moment." FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Les fichiers sauvegardés avant nettoyage apparaîtront ici." FontSize="12" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid>
            </Border>

            <!-- BARRE D'ACTIONS -->
            <Border Grid.Row="3"
                    Style="{StaticResource Card}"

                    Padding="16,12"
                    Margin="0,12,0,0">
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="SelectAllBtn"
                        Content="Tout sélectionner"
                        Style="{StaticResource SecondBtnStyle}"
                        Click="SelectAll_Click"
                        Margin="0,4,10,4"/>
                    <Button x:Name="RefreshBtn"
                            Content="Actualiser"
                            Style="{StaticResource SecondBtnStyle}"
                            Click="Refresh_Click"
                            Margin="0,4,10,4"/>
                    <Button x:Name="DeleteSelectedBtn"
                        Content="Supprimer la sélection"
                        Style="{StaticResource DangerBtnStyle}"
                        Click="DeleteSelected_Click"
                        Margin="0,4,10,4"
                        IsEnabled="False"/>
                    <Button x:Name="DeleteOldBtn"
                            Content="Supprimer les anciens" ToolTip="Supprimer définitivement les sauvegardes de plus de 30 jours."
                            Style="{StaticResource DangerBtnStyle}"
                            Click="DeleteOld_Click"
                            Margin="0,4,10,4"/>
                    <Button x:Name="RestoreBtn"
                            Content="Restaurer"
                            Style="{StaticResource AccentBtnStyle}"
                            Click="Restore_Click"
                            IsEnabled="False"/>
                </WrapPanel>
            </Border>

        </Grid>
    </Border>
</Window>
