<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyse de confidentialité" Height="700" Width="1040" MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Confidentialité"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" Text="Repérez les indices de données sensibles : mots de passe, jetons ou clés API. Vérifiez chaque résultat."
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- STATS -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Padding="20,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="StatCritical" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource RiskExpert}"/>
                        <TextBlock Text="Contenu à vérifier" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatMedium" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource RiskRecommended}"/>
                        <TextBlock Text="Nom à vérifier" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="StatTotal" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Total alertes" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- LISTE DES ALERTES -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,0,8,8">
                <Grid><ListView x:Name="AlertList"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource TextPrimary}"
                          FontSize="12"
                          SelectionMode="Multiple">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Risque" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RiskIcon}" FontSize="14"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Alerte" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Alert}" ToolTip="{Binding Alert}"
                                                   Foreground="{Binding AlertColor}"
                                                   FontWeight="SemiBold" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Chemin" Width="380">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,44,24,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AlertList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/><TextBlock Text="Un premier regard sur vos données." FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Lancez une analyse pour vérifier les fichiers potentiellement sensibles." FontSize="12" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid>
            </Border>

            <!-- ACTIONS -->
            <Border Grid.Row="3" Style="{StaticResource Card}"
                    Padding="16,12" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,16,0" Grid.Column="0" x:Name="StatusText"
                               Text="Lancez une analyse, puis vérifiez les alertes."
                               Foreground="{DynamicResource TextSecond}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="1" Content="Analyser"
                            Style="{StaticResource AccentBtn}"
                            Click="Scan_Click" x:Name="ScanBtn"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Supprimer la sélection"
                            Style="{StaticResource AccentBtn}"
                            Click="SecureSelected_Click"
                            x:Name="SecureBtn" IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
