<UserControl x:Class="OpenCleaner.UI.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{loc:Translate Privacy.Title}"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" Text="{loc:Translate Privacy.Subtitle}"
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- STATS -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Padding="20,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="StatCritical" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource RiskExpert}"/>
                        <TextBlock Text="{loc:Translate Privacy.StatCritical}" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatMedium" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource RiskRecommended}"/>
                        <TextBlock Text="{loc:Translate Privacy.StatMedium}" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="StatTotal" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{loc:Translate Privacy.StatTotal}" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- LISTE DES ALERTES -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,0,8,8">
                <Grid><ListView x:Name="AlertList"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource TextPrimary}"
                          FontSize="12"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="AlertList_SelectionChanged"
                          MouseDoubleClick="AlertList_DoubleClick"
                          SelectionMode="Multiple">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{loc:Translate Privacy.ColRisk}" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RiskIcon}" FontSize="14"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Translate Privacy.ColAlert}" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Alert}" ToolTip="{Binding Alert}"
                                                   Foreground="{Binding AlertColor}"
                                                   FontWeight="SemiBold" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Translate Privacy.ColPath}" Width="380">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,44,24,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AlertList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/><TextBlock Text="{loc:Translate Privacy.EmptyTitle}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{loc:Translate Privacy.EmptyDescription}" FontSize="12" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid>
            </Border>

            <!-- ACTIONS -->
            <Border Grid.Row="3" Style="{StaticResource Card}"
                    Padding="16,12" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,16,0" Grid.Column="0" x:Name="StatusText"
                               Text="{loc:Translate Privacy.Hint}"
                               Foreground="{DynamicResource TextSecond}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="1" Content="{loc:Translate Privacy.OpenLocation}"
                            Style="{StaticResource SecondBtn}"
                            Click="Reveal_Click" x:Name="RevealBtn"
                            IsEnabled="False" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="{loc:Translate Privacy.Analyze}"
                            Style="{StaticResource AccentBtn}"
                            Click="Scan_Click" x:Name="ScanBtn"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="3" Content="{loc:Translate Privacy.DeleteSelection}"
                            Style="{StaticResource AccentBtn}"
                            Click="SecureSelected_Click"
                            x:Name="SecureBtn" IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
