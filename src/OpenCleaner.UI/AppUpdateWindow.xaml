<Window x:Class="OpenCleaner.UI.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}"
        Title="{loc:Translate UpdateDialog.Title}" Icon="Assets/OpenCleaner.ico"
        Width="740" Height="680" MinWidth="640" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" UseLayoutRounding="True"
        AutomationProperties.Name="{loc:Translate UpdateDialog.Title}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource BgMain}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource BgSidebar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="{loc:Translate UpdateDialog.Title}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CaptionCloseButton" Grid.Column="1" Content="&#xE8BB;"
                        Width="46" MinHeight="46" Padding="0" BorderThickness="0"
                        Style="{StaticResource SecondBtnStyle}"
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Foreground="{DynamicResource TextSecond}"
                        ToolTip="{loc:Translate UpdateDialog.Close}"
                        AutomationProperties.Name="{loc:Translate UpdateDialog.Close}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsTabStop="False" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="28,18,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{loc:Translate UpdateDialog.Heading}" FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Translate UpdateDialog.Subtitle}" FontSize="12"
                               Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14,9" MinWidth="150">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate UpdateDialog.CurrentVersion}"
                                       Style="{StaticResource Eyebrow}" FontSize="9"/>
                            <TextBlock x:Name="CurrentVersionText" Text="—" FontSize="15"
                                       FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"
                               Margin="12,0" AutomationProperties.Name="{loc:Translate UpdateDialog.VersionArrowAutomation}"/>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,9" MinWidth="150"
                            Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate UpdateDialog.TargetVersion}"
                                       Style="{StaticResource Eyebrow}" FontSize="9"/>
                            <TextBlock x:Name="TargetVersionText" Text="—" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,15" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="StateTitleText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="{loc:Translate UpdateDialog.StatusAutomation}"/>
                        <TextBlock x:Name="StateDetailText" FontSize="12" Foreground="{DynamicResource TextSecond}"
                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <ProgressBar x:Name="UpdateProgressBar" Style="{StaticResource ModernProgressBar}"
                                     Height="6" Value="0" Visibility="Collapsed" Margin="0,12,0,0"
                                     AutomationProperties.Name="{loc:Translate UpdateDialog.ProgressAutomation}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="NotesTitleText" Text="{loc:Translate UpdateDialog.NotesTitle}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" MinHeight="80">
                            <TextBlock x:Name="UpdateNotesText" Text="{loc:Translate UpdateDialog.NotesEmpty}"
                                       TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                       Foreground="{DynamicResource TextSecond}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Padding="28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TransientText" Text="" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecond}" VerticalAlignment="Center"
                               Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PrimaryButton" Content="{loc:Translate UpdateDialog.Download}"
                                Style="{StaticResource AccentBtnStyle}" MinWidth="190" Height="38"
                                IsDefault="False" TabIndex="0" Click="Primary_Click"
                                AutomationProperties.Name="{loc:Translate UpdateDialog.Download}"/>
                        <Button x:Name="CloseButton" Content="{loc:Translate UpdateDialog.Close}"
                                Style="{StaticResource SecondBtnStyle}" MinWidth="110" Height="38"
                                IsCancel="True" TabIndex="1" Margin="10,0,0,0" Click="Close_Click"
                                AutomationProperties.Name="{loc:Translate UpdateDialog.Close}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
