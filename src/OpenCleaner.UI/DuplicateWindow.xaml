<UserControl x:Class="OpenCleaner.UI.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{loc:Translate Dup.Title}"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" Text="{loc:Translate Dup.Subtitle}"
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- STATS + BARRE PROGRESSION -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Padding="20,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DupGroups" Text="—"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="{loc:Translate Dup.StatGroups}"
                                   FontSize="11" Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="DupFiles" Text="—"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{loc:Translate Dup.StatFiles}"
                                   FontSize="11" Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="DupSize" Text="—"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RiskSafe}"/>
                        <TextBlock Text="{loc:Translate Dup.StatSize}"
                                   FontSize="11" Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" x:Name="ScanProgress"
                               Text="" Foreground="{DynamicResource TextSecond}"
                               FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- CONTENU : TreeView + Preview -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- TREEVIEW doublons -->
                <Border Grid.Column="0" Style="{StaticResource Card}"
                         Padding="4" Margin="0,0,8,0">
                    <Grid>
                        <TreeView x:Name="DupTree"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectedItemChanged="DupTree_SelectedItemChanged"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=DupTree}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="{loc:Translate Dup.EmptyTitle}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Text="{loc:Translate Dup.EmptyDescription}" FontSize="12" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PREVIEW IMAGE -->
                <Border Grid.Column="1" Style="{StaticResource Card}"
                         Padding="12">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Dup.Preview}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecond}"
                                   Margin="0,0,0,10"/>
                        <Border x:Name="PreviewBorder"
                                Background="{DynamicResource BgMain}" CornerRadius="6"
                                Height="160" Width="196">
                            <Grid>
                                <TextBlock x:Name="PreviewPlaceholder"
                                           Text="{loc:Translate Dup.PreviewHint}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecond}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="10"/>
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewName"
                                   Text="—" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock TextWrapping="Wrap" x:Name="PreviewSize"
                                   Text="" FontSize="10"
                                   Foreground="{DynamicResource TextSecond}"
                                   Margin="0,4,0,0"/>
                        <Button x:Name="RevealDupBtn"
                                Content="{loc:Translate Dup.OpenLocation}"
                                Style="{StaticResource SecondBtn}"
                                Padding="10,6" MinHeight="32"
                                Margin="0,12,0,0"
                                IsEnabled="False"
                                Click="RevealDup_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BARRE D'ACTIONS -->
            <Border Grid.Row="3" Style="{StaticResource Card}"
                     Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,16,0" x:Name="StatusText"
                                   Text="{loc:Translate Dup.Hint}"
                                   Foreground="{DynamicResource TextSecond}"
                                   FontSize="12"/>

                        <TextBlock x:Name="CurrentFileText"
                                   Text=""
                                   Foreground="{DynamicResource TextSecond}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="0.7"
                                   Margin="0,2,20,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="MinSizeCombo" Width="115" Margin="0,0,10,0" SelectedIndex="1"
                                  ToolTip="{loc:Translate Dup.MinSizeTip}"
                                  AutomationProperties.Name="{loc:Translate Dup.MinSizeAutomation}">
                            <ComboBoxItem Content="{loc:Translate Dup.Min100}" Tag="102400"/>
                            <ComboBoxItem Content="{loc:Translate Dup.Min1M}" Tag="1048576"/>
                            <ComboBoxItem Content="{loc:Translate Dup.Min10M}" Tag="10485760"/>
                            <ComboBoxItem Content="{loc:Translate Dup.Min50M}" Tag="52428800"/>
                        </ComboBox>
                        <Button x:Name="AutoSelectBtn"
                                Content="{loc:Translate Dup.CheckAll}"
                                Style="{StaticResource SecondBtn}"
                                Click="AutoSelect_Click"
                                IsEnabled="False"
                                Margin="0,0,8,0"/>
                        <Button x:Name="UnselectAllBtn"
                                Content="{loc:Translate Dup.UncheckAll}"
                                Style="{StaticResource SecondBtn}"
                                Click="UnselectAll_Click"
                                IsEnabled="False"
                                Margin="0,0,10,0"/>
                        <Button x:Name="ScanBtn"
                                Content="{loc:Translate Dup.Analyze}"
                                Style="{StaticResource SecondBtn}"
                                Click="Scan_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="DeleteBtn"
                                Content="{loc:Translate Dup.DeleteSelection}"
                                Style="{StaticResource AccentBtn}"
                                Click="Delete_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
