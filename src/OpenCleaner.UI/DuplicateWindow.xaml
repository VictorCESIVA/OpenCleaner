<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.DuplicateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détecteur de doublons" Height="740" Width="1160" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Doublons"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock TextWrapping="Wrap" Text="Comparez les copies dans vos dossiers personnels et choisissez les fichiers à conserver."
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- STATS + BARRE PROGRESSION -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Padding="20,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DupGroups" Text="—"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="Groupes de doublons"
                                   FontSize="11" Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="DupFiles" Text="—"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Copies trouvées"
                                   FontSize="11" Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="DupSize" Text="—"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RiskSafe}"/>
                        <TextBlock Text="Volume détecté"
                                   FontSize="11" Foreground="{DynamicResource TextSecond}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" x:Name="ScanProgress"
                               Text="" Foreground="{DynamicResource TextSecond}"
                               FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- CONTENU : TreeView + Preview -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- TREEVIEW doublons -->
                <Border Grid.Column="0" Style="{StaticResource Card}"
                         Padding="4" Margin="0,0,8,0">
                    <Grid>
                        <TreeView x:Name="DupTree"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectedItemChanged="DupTree_SelectedItemChanged"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=DupTree}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Gardez la bonne copie." FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Text="Lancez une analyse pour comparer vos fichiers." FontSize="12" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PREVIEW IMAGE -->
                <Border Grid.Column="1" Style="{StaticResource Card}"
                         Padding="12">
                    <StackPanel>
                        <TextBlock Text="Aperçu"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecond}"
                                   Margin="0,0,0,10"/>
                        <Border x:Name="PreviewBorder"
                                Background="{DynamicResource BgMain}" CornerRadius="6"
                                Height="160" Width="196">
                            <Grid>
                                <TextBlock x:Name="PreviewPlaceholder"
                                           Text="Sélectionnez un fichier pour voir l'aperçu"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecond}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="10"/>
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewName"
                                   Text="—" FontSize="11"
                                   Foreground="{DynamicResource TextSecond}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock TextWrapping="Wrap" x:Name="PreviewSize"
                                   Text="" FontSize="10"
                                   Foreground="{DynamicResource TextSecond}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BARRE D'ACTIONS -->
            <Border Grid.Row="3" Style="{StaticResource Card}"
                     Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,16,0" x:Name="StatusText"
                                   Text="Lancez une analyse pour comparer les fichiers."
                                   Foreground="{DynamicResource TextSecond}"
                                   FontSize="12"/>

                        <TextBlock x:Name="CurrentFileText"
                                   Text=""
                                   Foreground="{DynamicResource TextSecond}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="0.7"
                                   Margin="0,2,20,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="AutoSelectBtn"
                                Content="Sélection automatique"
                                Style="{StaticResource SecondBtn}"
                                Click="AutoSelect_Click"
                                IsEnabled="False"
                                Margin="0,0,10,0"/>
                        <Button x:Name="ScanBtn"
                                Content="Analyser"
                                Style="{StaticResource SecondBtn}"
                                Click="Scan_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="DeleteBtn"
                                Content="Supprimer la sélection"
                                Style="{StaticResource AccentBtn}"
                                Click="Delete_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
