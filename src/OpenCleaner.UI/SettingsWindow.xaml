<Window Style="{StaticResource {x:Type Window}}" x:Class="OpenCleaner.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres — Planificateur automatique"
        Height="760" Width="620"
        MinHeight="520" MinWidth="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Paramètres"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Planificateur de nettoyage automatique via le Planificateur de tâches Windows."
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- CONTENU SCROLLABLE -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-4,12">
                <StackPanel Margin="0,0,8,0">

                    <!-- SECTION : Activer / Désactiver -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Nettoyage automatique"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="EnabledCheck"
                                      Content="Activer le nettoyage automatique"
                                      Checked="EnabledCheck_Changed"
                                      Unchecked="EnabledCheck_Changed"/>
                            <TextBlock Text="Crée une tâche dans le Planificateur de tâches Windows."
                                       FontSize="11" Foreground="{DynamicResource TextSecond}"
                                       Margin="20,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Heure -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Heure de lancement"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TimeBox"
                                         Text="03:00" AutomationProperties.Name="Heure du nettoyage automatique"
                                         Width="80" Height="34"
                                         Background="{DynamicResource BgMain}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource Border}"
                                         Padding="8,6"
                                         FontSize="14"
                                         CaretBrush="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="(format HH:mm)"
                                           FontSize="11" Foreground="{DynamicResource TextSecond}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Jours -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Jours de la semaine"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="DayMon" Content="Lun" Tag="Monday"    Margin="0,4,16,4"/>
                                <CheckBox x:Name="DayTue" Content="Mar" Tag="Tuesday"   Margin="0,4,16,4"/>
                                <CheckBox x:Name="DayWed" Content="Mer" Tag="Wednesday" Margin="0,4,16,4"/>
                                <CheckBox x:Name="DayThu" Content="Jeu" Tag="Thursday"  Margin="0,4,16,4"/>
                                <CheckBox x:Name="DayFri" Content="Ven" Tag="Friday"    Margin="0,4,16,4"/>
                                <CheckBox x:Name="DaySat" Content="Sam" Tag="Saturday"  Margin="0,4,16,4"/>
                                <CheckBox x:Name="DaySun" Content="Dim" Tag="Sunday"    Margin="0,4,16,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Plugins -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Catégories à nettoyer"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="PlugSystem"  Content="Fichiers temporaires" Tag="system.temp"            Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugWinUpd" Content="Windows Update" Tag="system.windowsupdate" IsEnabled="False" IsChecked="False" ToolTipService.ShowOnDisabled="True" ToolTip="Nettoyage suspendu : utilisez les outils de stockage Windows." Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugBrowser" Content="Navigateurs"          Tag="browser.chrome"         Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugThumb"   Content="Miniatures"           Tag="system.thumbnailcache"  Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugOffice"  Content="Microsoft Office"               Tag="applications.office"    Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugSteam"   Content="Steam"                Tag="games.steam"            Margin="0,4,20,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Sauvegardes -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sauvegardes chiffrées"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="Le code de récupération permet de retrouver l'accès aux sauvegardes si la clé protégée par Windows est perdue. Conservez-le hors de cet ordinateur."
                                       FontSize="11" Foreground="{DynamicResource TextSecond}"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="CreateRecoveryBtn" Content="Créer un code"
                                        Style="{StaticResource SecondBtnStyle}"
                                        Click="CreateRecovery_Click" Margin="0,0,8,0"/>
                                <Button x:Name="RegenerateRecoveryBtn" Content="Régénérer"
                                        Style="{StaticResource SecondBtnStyle}"
                                        Click="RegenerateRecovery_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="RecoveryStatus" Text="" FontSize="12"
                                       Foreground="{DynamicResource TextSecond}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Mises à jour -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Version de l'application"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ApplicationVersionText" Foreground="{DynamicResource TextSecond}" Margin="0,0,0,12"/>
                            <StackPanel>
                                <Button x:Name="CheckUpdateBtn" Content="Vérifier les mises à jour"
                                        Style="{StaticResource AccentBtn}"
                                        Click="CheckUpdate_Click"
                                        IsEnabled="True"/>
                                <TextBlock x:Name="UpdateStatus" Text=""
                                           FontSize="12" Foreground="{DynamicResource TextSecond}"
                                           VerticalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="Une installation via Setup.exe recherche les mises à jour au démarrage. Leur application demande votre confirmation."
                                       FontSize="11" Foreground="{DynamicResource TextSecond}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- BARRE ACTIONS -->
            <Border Grid.Row="2" Style="{StaticResource Card}"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="SaveStatus" TextWrapping="Wrap" Margin="0,0,16,0"
                               Text="" Foreground="{DynamicResource TextSecond}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="1" Content="Enregistrer"
                            Style="{StaticResource AccentBtn}"
                            Click="Save_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
