<UserControl x:Class="OpenCleaner.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpenCleaner.UI.Localization">

    <Border Background="{DynamicResource BgMain}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EN-TÊTE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{loc:Translate Settings.Title}"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{loc:Translate Settings.Subtitle}"
                           FontSize="12" Foreground="{DynamicResource TextSecond}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- CONTENU SCROLLABLE -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-4,12">
                <StackPanel Margin="0,0,8,0">

                    <!-- SECTION : Activer / Désactiver -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.SchedulerTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="EnabledCheck"
                                      Content="{loc:Translate Settings.SchedulerEnable}"
                                      Checked="EnabledCheck_Changed"
                                      Unchecked="EnabledCheck_Changed"/>
                            <TextBlock Text="{loc:Translate Settings.SchedulerHint}"
                                       FontSize="11" Foreground="{DynamicResource TextSecond}"
                                       Margin="20,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Dernière exécution -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.RunsTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="LastRunText" Text="{loc:Translate Settings.NoRuns}"
                                       FontSize="12" Foreground="{DynamicResource TextSecond}"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="NextRunText" Text=""
                                       FontSize="11" Foreground="{DynamicResource TextSecond}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Langue -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.Language}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Translate Settings.LanguageHint}"
                                       FontSize="11" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap"/>
                            <ComboBox x:Name="LanguageCombo" Width="220" Height="34" Margin="0,8,0,0"
                                      SelectionChanged="LanguageCombo_Changed"
                                      AutomationProperties.Name="{loc:Translate Settings.Language}">
                                <ComboBoxItem Content="{loc:Translate Settings.French}" Tag="fr"/>
                                <ComboBoxItem Content="{loc:Translate Settings.English}" Tag="en"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Heure -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.TimeTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TimeBox"
                                         Text="03:00" AutomationProperties.Name="{loc:Translate Settings.TimeAutomation}"
                                         Width="80" Height="34"
                                         Background="{DynamicResource BgMain}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource Border}"
                                         Padding="8,6"
                                         FontSize="14"
                                         CaretBrush="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{loc:Translate Settings.TimeHint}"
                                           FontSize="11" Foreground="{DynamicResource TextSecond}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Jours -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.DaysTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="DayMon" Content="{loc:Translate Settings.DayMon}" Tag="Monday"    Margin="0,4,16,4"/>
                                <CheckBox x:Name="DayTue" Content="{loc:Translate Settings.DayTue}" Tag="Tuesday"   Margin="0,4,16,4"/>
                                <CheckBox x:Name="DayWed" Content="{loc:Translate Settings.DayWed}" Tag="Wednesday" Margin="0,4,16,4"/>
                                <CheckBox x:Name="DayThu" Content="{loc:Translate Settings.DayThu}" Tag="Thursday"  Margin="0,4,16,4"/>
                                <CheckBox x:Name="DayFri" Content="{loc:Translate Settings.DayFri}" Tag="Friday"    Margin="0,4,16,4"/>
                                <CheckBox x:Name="DaySat" Content="{loc:Translate Settings.DaySat}" Tag="Saturday"  Margin="0,4,16,4"/>
                                <CheckBox x:Name="DaySun" Content="{loc:Translate Settings.DaySun}" Tag="Sunday"    Margin="0,4,16,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Plugins -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.CategoriesTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="PlugSystem"  Content="{loc:Translate Settings.CategorySystem}" Tag="system.temp"            Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugWinUpd" Content="{loc:Translate Settings.CategoryWindowsUpdate}" Tag="system.windowsupdate" IsEnabled="False" IsChecked="False" ToolTipService.ShowOnDisabled="True" ToolTip="{loc:Translate Nav.WindowsUpdateTip}" Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugBrowser" Content="{loc:Translate Settings.CategoryBrowsers}"          Tag="browser.chrome"         Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugThumb"   Content="{loc:Translate Settings.CategoryThumbnails}"           Tag="system.thumbnailcache"  Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugOffice"  Content="{loc:Translate Settings.CategoryOffice}"               Tag="applications.office"    Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugSteam"   Content="{loc:Translate Settings.CategorySteam}"                Tag="games.steam"            Margin="0,4,20,4"/>
                                <CheckBox x:Name="PlugAppCaches" Content="{loc:Translate Settings.CategoryAppCaches}" Tag="applications.caches" Margin="0,4,20,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.ScheduleBackupTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ScheduledBackupCheck" Content="{loc:Translate Settings.ScheduleBackupOption}" IsChecked="True"/>
                            <TextBlock Text="{loc:Translate Settings.ScheduleBackupHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecond}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Exclusions -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.ExclusionsTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Translate Settings.ExclusionsDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap"/>
                            <ListBox x:Name="ExclusionsList" Height="90" Margin="0,8,0,0"
                                     Style="{StaticResource ToolListBoxStyle}"
                                     ItemContainerStyle="{StaticResource ToolListItemStyle}"
                                     SelectionChanged="ExclusionsList_SelectionChanged"
                                     AutomationProperties.Name="{loc:Translate Settings.ExclusionsAutomation}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecond}"
                                                   Margin="10,5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="AddExclusionBtn" Content="{loc:Translate Settings.AddFolder}"
                                        Style="{StaticResource SecondBtnStyle}"
                                        Click="AddExclusion_Click" Margin="0,0,8,0"/>
                                <Button x:Name="RemoveExclusionBtn" Content="{loc:Translate Settings.RemoveFolder}"
                                        Style="{StaticResource SecondBtnStyle}"
                                        Click="RemoveExclusion_Click" IsEnabled="False"/>
                            </WrapPanel>
                            <TextBlock x:Name="ExclusionsStatus" FontSize="11"
                                       Foreground="{DynamicResource TextSecond}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Alerte d'espace -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.PreferencesTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="{loc:Translate Settings.PreferencesDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{loc:Translate Settings.ThresholdLabel}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextSecond}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="LowSpaceCombo" Width="120" Height="34"
                                          SelectionChanged="LowSpaceCombo_Changed"
                                          AutomationProperties.Name="{loc:Translate Settings.ThresholdAutomation}">
                                    <ComboBoxItem Content="5 %" Tag="5"/>
                                    <ComboBoxItem Content="10 %" Tag="10"/>
                                    <ComboBoxItem Content="15 %" Tag="15"/>
                                    <ComboBoxItem Content="20 %" Tag="20"/>
                                    <ComboBoxItem Content="25 %" Tag="25"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="PreferencesStatus" FontSize="11"
                                       Foreground="{DynamicResource TextSecond}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Sauvegardes -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.BackupsTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Translate Settings.BackupHint}"
                                       FontSize="11" Foreground="{DynamicResource TextSecond}"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="CreateRecoveryBtn" Content="{loc:Translate Settings.CreateCode}"
                                        Style="{StaticResource SecondBtnStyle}"
                                        Click="CreateRecovery_Click" Margin="0,0,8,0"/>
                                <Button x:Name="RegenerateRecoveryBtn" Content="{loc:Translate Settings.RegenerateCode}"
                                        Style="{StaticResource SecondBtnStyle}"
                                        Click="RegenerateRecovery_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="RecoveryStatus" Text="" FontSize="12"
                                       Foreground="{DynamicResource TextSecond}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION : Mises à jour -->
                    <Border Style="{StaticResource Card}"
                            Padding="20,14" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Settings.VersionTitle}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ApplicationVersionText" Foreground="{DynamicResource TextSecond}" Margin="0,0,0,12"/>
                            <StackPanel>
                                <Button x:Name="CheckUpdateBtn" Content="{loc:Translate Settings.CheckUpdates}"
                                        Style="{StaticResource AccentBtn}"
                                        Click="CheckUpdate_Click"
                                        IsEnabled="True"/>
                                <TextBlock x:Name="UpdateStatus" Text=""
                                           FontSize="12" Foreground="{DynamicResource TextSecond}"
                                           VerticalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Translate Settings.UpdateHint}"
                                       FontSize="11" Foreground="{DynamicResource TextSecond}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- BARRE ACTIONS -->
            <Border Grid.Row="2" Style="{StaticResource Card}"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="SaveStatus" TextWrapping="Wrap" Margin="0,0,16,0"
                               Text="" Foreground="{DynamicResource TextSecond}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="1" Content="{loc:Translate Settings.Save}"
                            Style="{StaticResource AccentBtn}"
                            Click="Save_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
